{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agskoleintra.local/contracts/sync-request-v1.schema.json",
  "title": "Skoleklar sync request v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "device_id", "last_manifest_id", "completed_stable_keys", "observed_at"],
  "properties": {
    "schema_version": {"const": 1},
    "device_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,63}$"},
    "last_manifest_id": {
      "oneOf": [
        {"type": "string", "pattern": "^[0-9TZ:-]+-[a-f0-9]{12}$"},
        {"type": "null"}
      ]
    },
    "completed_stable_keys": {
      "type": "array",
      "maxItems": 200,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 256}
    },
    "observed_at": {"type": "string", "format": "date-time"}
  }
}
