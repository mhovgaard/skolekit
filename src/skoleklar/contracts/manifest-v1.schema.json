{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agskoleintra.local/contracts/manifest-v1.schema.json",
  "title": "Skoleklar delivery manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "manifest_id",
    "generated_at",
    "expires_at",
    "headline",
    "calendar",
    "reminders",
    "review",
    "brief"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "manifest_id": {"type": "string", "pattern": "^[0-9TZ:-]+-[a-f0-9]{12}$"},
    "generated_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"},
    "headline": {"type": "string", "minLength": 1, "maxLength": 160},
    "calendar": {
      "type": "array",
      "maxItems": 100,
      "items": {"$ref": "#/$defs/calendar_item"}
    },
    "reminders": {
      "type": "array",
      "maxItems": 100,
      "items": {"$ref": "#/$defs/reminder_item"}
    },
    "review": {
      "type": "array",
      "maxItems": 100,
      "items": {"$ref": "#/$defs/review_item"}
    },
    "brief": {"$ref": "#/$defs/brief"},
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "processor", "checked", "thread_count", "unread_count", "new_thread_count", "new_count", "unretrieved_count", "bodies_retained"],
      "properties": {
        "mode": {"type": "string", "enum": ["off", "events-only", "legacy"]},
        "processor": {"type": "string", "enum": ["disabled", "local", "zdr"]},
        "checked": {"type": "boolean"},
        "thread_count": {"type": "integer", "minimum": 0},
        "unread_count": {"type": "integer", "minimum": 0},
        "new_thread_count": {"type": "integer", "minimum": 0},
        "new_count": {"type": "integer", "minimum": 0},
        "unretrieved_count": {"type": "integer", "minimum": 0},
        "bodies_retained": {"type": ["integer", "null"], "minimum": 0}
      }
    }
  },
  "$defs": {
    "stable_key": {"type": "string", "minLength": 1, "maxLength": 256},
    "state": {"type": "string", "enum": ["active", "cancelled"]},
    "source_url": {
      "oneOf": [
        {"type": "string", "format": "uri", "maxLength": 2048},
        {"type": "null"}
      ]
    },
    "calendar_item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stable_key", "revision", "state", "title", "start", "end",
        "all_day", "notes", "source_url"
      ],
      "properties": {
        "stable_key": {"$ref": "#/$defs/stable_key"},
        "revision": {"type": "integer", "minimum": 1, "maximum": 2147483647},
        "state": {"$ref": "#/$defs/state"},
        "title": {"type": "string", "minLength": 1, "maxLength": 200},
        "start": {"type": "string", "format": "date"},
        "end": {
          "oneOf": [
            {"type": "string", "format": "date"},
            {"type": "null"}
          ]
        },
        "all_day": {"const": true},
        "notes": {"type": "string", "maxLength": 2000},
        "source_url": {"$ref": "#/$defs/source_url"}
      }
    },
    "reminder_item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stable_key", "revision", "state", "list", "title", "due",
        "notes", "source_url"
      ],
      "properties": {
        "stable_key": {"$ref": "#/$defs/stable_key"},
        "revision": {"type": "integer", "minimum": 1, "maximum": 2147483647},
        "state": {"$ref": "#/$defs/state"},
        "list": {
          "type": "string",
          "enum": ["School · Deadlines", "School · Bring home"]
        },
        "title": {"type": "string", "minLength": 1, "maxLength": 200},
        "due": {"type": "string", "format": "date"},
        "notes": {"type": "string", "maxLength": 2000},
        "source_url": {"$ref": "#/$defs/source_url"}
      }
    },
    "review_item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stable_key", "title", "summary", "reason"],
      "properties": {
        "stable_key": {"$ref": "#/$defs/stable_key"},
        "title": {"type": "string", "minLength": 1, "maxLength": 200},
        "summary": {"type": "string", "minLength": 1, "maxLength": 1000},
        "reason": {"type": "string", "minLength": 1, "maxLength": 500}
      }
    },
    "brief": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "body", "signal"],
      "properties": {
        "title": {"type": "string", "minLength": 1, "maxLength": 200},
        "body": {"type": "string", "minLength": 1, "maxLength": 6000},
        "signal": {"type": "string", "enum": ["green", "amber", "red"]}
      }
    }
  }
}
