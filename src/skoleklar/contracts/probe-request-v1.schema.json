{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agskoleintra.local/contracts/probe-request-v1.schema.json",
  "title": "Skoleklar probe request v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["device_id", "nonce"],
  "properties": {
    "device_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,63}$"},
    "nonce": {"type": "string", "minLength": 1, "maxLength": 128}
  }
}
