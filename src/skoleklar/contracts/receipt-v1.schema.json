{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agskoleintra.local/contracts/receipt-v1.schema.json",
  "title": "Skoleklar hydration receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "device_id", "manifest_id", "applied_stable_keys",
    "failed", "finished_at"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "device_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,63}$"},
    "manifest_id": {"type": "string", "pattern": "^[0-9TZ:-]+-[a-f0-9]{12}$"},
    "applied_stable_keys": {
      "type": "array",
      "maxItems": 200,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 256}
    },
    "failed": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["stable_key", "code"],
        "properties": {
          "stable_key": {"type": "string", "minLength": 1, "maxLength": 256},
          "code": {"type": "string", "pattern": "^[a-z][a-z0-9_]{1,63}$"}
        }
      }
    },
    "finished_at": {"type": "string", "format": "date-time"}
  }
}
