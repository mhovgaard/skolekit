{
  "displayName": "AG delivery unusual backend request volume",
  "documentation": {
    "content": "More than 30 requests reached the private delivery backend in five minutes. Check API Gateway and Cloud Run logs, rotate the gateway and device keys if traffic is not expected.",
    "mimeType": "text/markdown"
  },
  "userLabels": {
    "app": "agskoleintra",
    "risk": "cost-abuse"
  },
  "conditions": [
    {
      "displayName": "Delivery backend requests above 30 per five minutes",
      "conditionThreshold": {
        "filter": "resource.type = \"cloud_run_revision\" AND resource.labels.service_name = \"agskoleintra-delivery\" AND metric.type = \"run.googleapis.com/request_count\"",
        "aggregations": [
          {
            "alignmentPeriod": "300s",
            "perSeriesAligner": "ALIGN_SUM",
            "crossSeriesReducer": "REDUCE_SUM",
            "groupByFields": ["resource.labels.service_name"]
          }
        ],
        "comparison": "COMPARISON_GT",
        "thresholdValue": 30,
        "duration": "0s",
        "trigger": {"count": 1}
      }
    }
  ],
  "combiner": "OR",
  "enabled": true,
  "notificationChannels": []
}
